---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Puzzle from '../../components/Puzzle.svelte';
import Toolkit from '../../components/Toolkit.astro';
import MorsePlayer from '../../components/MorsePlayer.svelte';
import Pigpen from '../../components/Pigpen.astro';
import { casePuzzles, lessonPuzzles } from '../../lib/content';
import { sealAll, type Payload } from '../../lib/seal';

export async function getStaticPaths() {
  const puzzles = await getCollection('puzzles');
  return puzzles.map((puzzle) => ({ params: { id: puzzle.id }, props: { puzzle } }));
}

const { puzzle } = Astro.props;
const { Content } = await render(puzzle);
const lesson = puzzle.data.lesson ? await getEntry(puzzle.data.lesson) : undefined;
const kase = puzzle.data.case ? await getEntry(puzzle.data.case) : undefined;
// Where this puzzle lives: a lesson's practice puzzles, or a case's files.
const parent = lesson
  ? { href: `/learn/${lesson.id}`, title: lesson.data.title, noun: 'puzzle' }
  : { href: `/cases/${kase!.id}`, title: `Case ${kase!.data.number}: ${kase!.data.title}`, noun: 'file' };
const siblings = lesson ? await lessonPuzzles(lesson.id) : await casePuzzles(kase!.id);
const nextPuzzle = siblings[siblings.indexOf(siblings.find((p) => p.id === puzzle.id)!) + 1];

// Answers and writeups are sealed here, at build time. The page only ever sees the sealed entries.
const entries = await sealAll(`puzzle/${puzzle.id}`, [
  ...puzzle.data.answers.map((answer) => ({ answer, payload: { type: 'solve', writeup: puzzle.data.writeup, display: answer.toUpperCase() } as Payload })),
  ...puzzle.data.partials.map((p) => ({ answer: p.answer, payload: { type: 'partial', reply: p.reply } as Payload })),
]);
---

<Base title={puzzle.data.title}>
  <article class="puzzle-page page">
    <header>
      <p class="meta">
        <a href={parent.href}>{parent.title}</a>, {parent.noun} {siblings.indexOf(siblings.find((p) => p.id === puzzle.id)!) + 1} of {siblings.length}
      </p>
      <h1>{puzzle.data.title}</h1>
      <p class="difficulty meta" aria-label={`Difficulty ${puzzle.data.difficulty} of 5`}>
        {Array.from({ length: 5 }, (_, i) => <span class:list={['pip', { on: i < puzzle.data.difficulty }]} />)}
        <span aria-hidden="true">Difficulty {puzzle.data.difficulty} of 5</span>
      </p>
    </header>

    <div class="prompt prose"><Content /></div>

    {
      puzzle.data.ciphertext && puzzle.data.display === 'morse-audio' && (
        <figure class="cipher-block audio">
          <MorsePlayer client:load code={puzzle.data.ciphertext} label="Play the signal" />
          <figcaption class="meta">Sound only. Listen as many times as you like, at any speed.</figcaption>
        </figure>
      )
    }

    {
      puzzle.data.files.length > 0 && (
        <div class="files">
          {puzzle.data.files.map((f) => {
            const url = `/${f.path}`;
            const isImage = /\.(png|jpe?g|gif|webp)$/i.test(f.path);
            const isAudio = /\.(wav|mp3|ogg|flac)$/i.test(f.path);
            return (
              <figure class="file">
                {isImage && <img src={url} alt={f.label} loading="lazy" />}
                {isAudio && <audio controls preload="none" src={url} />}
                <figcaption>
                  <span>{f.label}</span>
                  <a href={url} download>
                    Download {f.path.split('/').pop()}
                  </a>
                </figcaption>
              </figure>
            );
          })}
        </div>
      )
    }

    {
      puzzle.data.page && (
        <figure class="book-page">
          {puzzle.data.page
            .trim()
            .split('\n')
            .map((line) => <p>{line}</p>)}
        </figure>
      )
    }

    {
      puzzle.data.ciphertext && puzzle.data.display === 'pigpen' && (
        <figure class="cipher-block">
          <Pigpen text={puzzle.data.ciphertext} />
        </figure>
      )
    }

    {
      puzzle.data.ciphertext && puzzle.data.display === 'text' && (
        <figure class="cipher-block">
          <p class="ciphertext" id="ciphertext">{puzzle.data.ciphertext}</p>
          <figcaption>
            <button type="button" class="copy" data-copy={puzzle.data.ciphertext}>
              Copy text
            </button>
          </figcaption>
        </figure>
      )
    }

    <Puzzle
      client:load
      id={puzzle.id}
      entries={entries}
      hints={puzzle.data.hints}
      next={nextPuzzle && { href: `/puzzles/${nextPuzzle.id}`, title: nextPuzzle.data.title }}
      back={{ href: parent.href, title: parent.title }}
    />

    <Toolkit
      text={puzzle.data.display === 'text' ? (puzzle.data.ciphertext ?? '') : ''}
      open={lesson?.data.tool}
      page={puzzle.data.page}
      file={puzzle.data.files[0] && `/${puzzle.data.files[0].path}`}
    />
  </article>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed: select the text instead';
      }
      setTimeout(() => (btn.textContent = 'Copy text'), 2000);
    });
  }
</script>

<style>
  .puzzle-page {
    display: grid;
    gap: 2rem;
  }
  .puzzle-page > * {
    max-width: 44rem;
  }
  header {
    display: grid;
    gap: 0.6rem;
    padding-top: 2rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  .difficulty {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .pip {
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--ink-soft);
    border-radius: 1px;
  }
  .pip.on {
    background: var(--ink);
    border-color: var(--ink);
  }
  .difficulty > span:last-child {
    margin-left: 0.4rem;
  }

  .files {
    display: grid;
    gap: 1rem;
  }
  .file {
    margin: 0;
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  .file img {
    max-width: 100%;
    height: auto;
    border-radius: 2px;
    image-rendering: auto;
  }
  .file audio {
    width: 100%;
  }
  .file figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .book-page {
    margin: 0;
    padding: 1.5rem 1.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
    box-shadow: 4px 4px 0 var(--rule);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .book-page p {
    margin: 0;
    white-space: pre-wrap;
  }

  .prompt {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .cipher-block {
    margin: 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  figcaption {
    margin-top: 0.5rem;
  }
  .copy {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.18em;
  }
  .copy:hover {
    color: var(--ink);
  }

</style>
