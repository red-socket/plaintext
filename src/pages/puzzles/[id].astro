---
import { url } from '../../lib/url';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Puzzle from '../../components/Puzzle.svelte';
import Toolkit from '../../components/Toolkit.astro';
import MorsePlayer from '../../components/MorsePlayer.svelte';
import Pigpen from '../../components/Pigpen.astro';
import Worksheet from '../../components/Worksheet.astro';
import { casePuzzles, lessonNumber, lessonPuzzles, sortedLessons } from '../../lib/content';
import { TRACKS } from '../../lib/catalog';
import { sealAll, type Payload } from '../../lib/seal';

export async function getStaticPaths() {
  const puzzles = await getCollection('puzzles');
  return puzzles.map((puzzle) => ({ params: { id: puzzle.id }, props: { puzzle } }));
}

const { puzzle } = Astro.props;
const { Content } = await render(puzzle);
const lesson = puzzle.data.lesson ? await getEntry(puzzle.data.lesson) : undefined;
const kase = puzzle.data.case ? await getEntry(puzzle.data.case) : undefined;
// Where this puzzle lives: a lesson's practice puzzles, or a case's files.
const parent = lesson
  ? { href: url(`/learn/${lesson.id}`), title: lesson.data.title, noun: 'puzzle' }
  : { href: url(`/cases/${kase!.id}`), title: `Case ${kase!.data.number}: ${kase!.data.title}`, noun: 'file' };
const siblings = lesson ? await lessonPuzzles(lesson.id) : await casePuzzles(kase!.id);
const index = siblings.indexOf(siblings.find((p) => p.id === puzzle.id)!);
const nextPuzzle = siblings[index + 1];
const track = lesson && TRACKS.find((t) => t.id === lesson.data.track)!;
const filing = lesson ? `Lesson ${lessonNumber(lesson, await sortedLessons())}, puzzle ${index + 1}` : `Case ${kase!.data.number}, file ${index + 1}`;
const crumb = lesson ? { href: url('/#tracks'), title: `Track ${track!.number}: ${track!.title}` } : { href: url('/#tracks'), title: 'Cases' };

// Short, all-capital letter ciphers get a worksheet: one box per letter with room for working under it.
const ct = puzzle.data.display === 'text' ? (puzzle.data.ciphertext ?? '') : '';
const squeezed = ct.replace(/\s/g, '');
const worksheet =
  ct.length > 0 &&
  ct.length <= 120 &&
  ct === ct.toUpperCase() &&
  (squeezed.match(/[A-Z]/g) ?? []).length / squeezed.length >= 0.9 &&
  new Set(squeezed.replace(/[^A-Z]/g, '')).size >= 6;
const letterCount = (ct.match(/[A-Z]/g) ?? []).length;

// Answers and writeups are sealed here, at build time. The page only ever sees the sealed entries.
const entries = await sealAll(`puzzle/${puzzle.id}`, [
  ...puzzle.data.answers.map((answer) => ({ answer, payload: { type: 'solve', writeup: puzzle.data.writeup, display: answer.toUpperCase() } as Payload })),
  ...puzzle.data.partials.map((p) => ({ answer: p.answer, payload: { type: 'partial', reply: p.reply } as Payload })),
]);
---

<Base title={puzzle.data.title} filing={filing}>
  <article class="puzzle-page page">
    <header>
      <nav class="crumbs filing" aria-label="Breadcrumb">
        <a href={crumb.href}>{crumb.title}</a> <span aria-hidden="true">/</span> <a href={parent.href}>{parent.title}</a>
        <span aria-hidden="true">/</span> {parent.noun === 'file' ? 'File' : 'Puzzle'} {index + 1} of {siblings.length}
      </nav>
      <h1>{puzzle.data.title}</h1>
      <p class="difficulty filing">
        <span class="meter" aria-hidden="true">
          {Array.from({ length: 5 }, (_, i) => <i class:list={{ on: i < puzzle.data.difficulty }} />)}
        </span>
        Difficulty {puzzle.data.difficulty} of 5
      </p>
    </header>

    <div class="prompt prose"><Content /></div>

    {
      puzzle.data.ciphertext && puzzle.data.display === 'morse-audio' && (
        <figure class="cipher-block audio">
          <MorsePlayer client:load code={puzzle.data.ciphertext} label="Play the signal" />
          <figcaption class="meta">Sound only. Listen as many times as you like, at any speed.</figcaption>
        </figure>
      )
    }

    {
      puzzle.data.files.length > 0 && (
        <div class="files">
          {puzzle.data.files.map((f) => {
            const href = url(f.path);
            const isImage = /\.(png|jpe?g|gif|webp)$/i.test(f.path);
            const isAudio = /\.(wav|mp3|ogg|flac)$/i.test(f.path);
            return (
              <figure class="file">
                {isImage && <img src={href} alt={f.label} loading="lazy" />}
                {isAudio && <audio controls preload="none" src={href} />}
                <figcaption>
                  <span>{f.label}</span>
                  <a href={href} download>
                    Download {f.path.split('/').pop()}
                  </a>
                </figcaption>
              </figure>
            );
          })}
        </div>
      )
    }

    {
      puzzle.data.page && (
        <figure class="book-page">
          {puzzle.data.page
            .trim()
            .split('\n')
            .map((line) => <p>{line}</p>)}
        </figure>
      )
    }

    {
      puzzle.data.ciphertext && puzzle.data.display === 'pigpen' && (
        <figure class="cipher-block">
          <Pigpen text={puzzle.data.ciphertext} />
        </figure>
      )
    }

    {
      puzzle.data.ciphertext && puzzle.data.display === 'text' && (
        <figure class="intercept">
          <figcaption class="intercept-head">
            <b>The message</b>
            <span>
              {worksheet ? `${letterCount} letters. Write your working under each one.` : 'Copy it into a tool below, or work on paper.'}{' '}
              <button type="button" class="link" data-copy={puzzle.data.ciphertext}>
                Copy text
              </button>
            </span>
          </figcaption>
          {worksheet ? (
            <>
              <p class="sr-only" id="ciphertext">
                {puzzle.data.ciphertext}
              </p>
              <Worksheet id={puzzle.id} text={puzzle.data.ciphertext} />
            </>
          ) : (
            <p class="ciphertext squared" id="ciphertext">
              {puzzle.data.ciphertext}
            </p>
          )}
        </figure>
      )
    }

    <Puzzle
      client:load
      id={puzzle.id}
      entries={entries}
      hints={puzzle.data.hints}
      next={nextPuzzle && { href: url(`/puzzles/${nextPuzzle.id}`), title: nextPuzzle.data.title }}
      back={{ href: parent.href, title: parent.title }}
    />

    <Toolkit
      text={puzzle.data.display === 'text' ? (puzzle.data.ciphertext ?? '') : ''}
      open={lesson?.data.tool}
      page={puzzle.data.page}
      file={puzzle.data.files[0] && url(puzzle.data.files[0].path)}
    />
  </article>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed: select the text instead';
      }
      setTimeout(() => (btn.textContent = 'Copy text'), 2000);
    });
  }
</script>

<style>
  .puzzle-page {
    display: grid;
    gap: 2rem;
  }
  .puzzle-page > :global(*) {
    max-width: 46rem;
  }
  header {
    display: grid;
    gap: 0.9rem;
    padding-top: 2.5rem;
  }
  .crumbs {
    margin-bottom: 0.75rem;
  }
  .crumbs span {
    margin: 0 0.4em;
    color: var(--rule);
  }
  h1 {
    font-size: clamp(2.8rem, 1.5rem + 5vw, 5.2rem);
  }
  .difficulty {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink);
  }
  .meter {
    display: flex;
    gap: 4px;
  }
  .meter i {
    width: 16px;
    height: 16px;
    border: 2px solid var(--ink);
  }
  .meter i.on {
    background: var(--ink);
  }

  .prompt {
    font-size: 1.25rem;
    line-height: 1.55;
  }

  /* Anything you were given to work on sits in a boxed exhibit with a caption bar. */
  .intercept,
  .cipher-block,
  .file,
  .book-page {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--field);
  }
  .intercept-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.25rem;
    padding: 0.6rem 1rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .intercept-head b {
    font-weight: 600;
  }
  .intercept-head span {
    color: var(--ink-soft);
  }
  .intercept-head .link {
    margin-left: 0.5rem;
    color: var(--ink);
  }
  .intercept > .ciphertext {
    padding: 1.25rem 1.1rem;
  }
  .cipher-block {
    padding: 1.25rem;
  }
  .cipher-block figcaption {
    margin-top: 0.75rem;
  }

  .files {
    display: grid;
    gap: 1rem;
  }
  .file {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }
  .file img {
    max-width: 100%;
    height: auto;
    image-rendering: auto;
    border: 1px solid var(--ink);
  }
  .file audio {
    width: 100%;
  }
  .file figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .file figcaption a {
    color: var(--ink);
  }
  .book-page {
    padding: 1.5rem 1.75rem;
    box-shadow: 5px 5px 0 var(--ink);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .book-page p {
    margin: 0;
    white-space: pre-wrap;
  }
  figcaption {
    margin-top: 0;
  }
  @media (max-width: 40rem) {
    .intercept-head .link {
      margin-left: 0;
    }
  }
</style>
