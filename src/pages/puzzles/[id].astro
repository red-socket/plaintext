---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Puzzle from '../../components/Puzzle.svelte';
import ToolGate from '../../components/ToolGate.astro';
import CipherWheel from '../../components/tools/CipherWheel.svelte';
import { TOOLS } from '../../lib/catalog';
import { lessonPuzzles } from '../../lib/content';
import { sealAll, type Payload } from '../../lib/seal';

export async function getStaticPaths() {
  const puzzles = await getCollection('puzzles');
  return puzzles.map((puzzle) => ({ params: { id: puzzle.id }, props: { puzzle } }));
}

const { puzzle } = Astro.props;
const { Content } = await render(puzzle);
const lesson = (await getEntry(puzzle.data.lesson))!;
const siblings = await lessonPuzzles(lesson.id);
const nextPuzzle = siblings[siblings.indexOf(siblings.find((p) => p.id === puzzle.id)!) + 1];
const lessons = await getCollection('lessons');
const lessonTitle = (id: string) => lessons.find((l) => l.id === id)?.data.title ?? id;

// Answers and writeups are sealed here, at build time. The page only ever sees the sealed entries.
const entries = await sealAll(`puzzle/${puzzle.id}`, [
  ...puzzle.data.answers.map((answer) => ({ answer, payload: { type: 'solve', writeup: puzzle.data.writeup } as Payload })),
  ...puzzle.data.partials.map((p) => ({ answer: p.answer, payload: { type: 'partial', reply: p.reply } as Payload })),
]);
---

<Base title={puzzle.data.title}>
  <article class="puzzle-page page">
    <header>
      <p class="meta">
        <a href={`/learn/${lesson.id}`}>{lesson.data.title}</a>, puzzle {puzzle.data.order} of {siblings.length}
      </p>
      <h1>{puzzle.data.title}</h1>
      <p class="difficulty meta" aria-label={`Difficulty ${puzzle.data.difficulty} of 5`}>
        {Array.from({ length: 5 }, (_, i) => <span class:list={['pip', { on: i < puzzle.data.difficulty }]} />)}
        <span aria-hidden="true">Difficulty {puzzle.data.difficulty} of 5</span>
      </p>
    </header>

    <div class="prompt prose"><Content /></div>

    {
      puzzle.data.ciphertext && (
        <figure class="cipher-block">
          <p class="ciphertext" id="ciphertext">{puzzle.data.ciphertext}</p>
          <figcaption>
            <button type="button" class="copy" data-copy={puzzle.data.ciphertext}>
              Copy text
            </button>
          </figcaption>
        </figure>
      )
    }

    <Puzzle
      client:load
      id={puzzle.id}
      entries={entries}
      hints={puzzle.data.hints}
      next={nextPuzzle && { href: `/puzzles/${nextPuzzle.id}`, title: nextPuzzle.data.title }}
      lesson={{ href: `/learn/${lesson.id}`, title: lesson.data.title }}
    />

    <section class="toolkit" aria-labelledby="toolkit-title">
      <h2 id="toolkit-title">Your toolkit</h2>
      {
        TOOLS.map((tool) => (
          <ToolGate tool={tool.id} lessonTitle={lessonTitle(tool.lesson)}>
            {tool.id === 'caesar-wheel' && <CipherWheel client:visible shift={0} mode="decrypt" text={puzzle.data.ciphertext ?? ''} />}
          </ToolGate>
        ))
      }
    </section>
  </article>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Copy failed: select the text instead';
      }
      setTimeout(() => (btn.textContent = 'Copy text'), 2000);
    });
  }
</script>

<style>
  .puzzle-page {
    display: grid;
    gap: 2rem;
  }
  .puzzle-page > * {
    max-width: 44rem;
  }
  header {
    display: grid;
    gap: 0.6rem;
    padding-top: 2rem;
  }
  h1 {
    font-size: var(--step-4);
  }
  .difficulty {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
  .pip {
    width: 0.6rem;
    height: 0.6rem;
    border: 1.5px solid var(--ink-soft);
    border-radius: 1px;
  }
  .pip.on {
    background: var(--ink);
    border-color: var(--ink);
  }
  .difficulty > span:last-child {
    margin-left: 0.4rem;
  }

  .prompt {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .cipher-block {
    margin: 0;
    padding: 1.25rem 1.25rem 0.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }
  figcaption {
    margin-top: 0.5rem;
  }
  .copy {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: var(--step--1);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.18em;
  }
  .copy:hover {
    color: var(--ink);
  }

  .toolkit {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
    max-width: 56rem;
  }
  .toolkit h2 {
    font-size: var(--step-1);
  }
</style>
