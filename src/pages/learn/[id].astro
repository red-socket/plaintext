---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LessonComplete from '../../components/LessonComplete.svelte';
import PuzzleList from '../../components/PuzzleList.astro';
import { PRACTICE, TRACKS, toolById } from '../../lib/catalog';
import { lessonPuzzles } from '../../lib/content';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return lessons.map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const track = TRACKS.find((t) => t.id === lesson.data.track)!;
const tool = lesson.data.tool ? toolById(lesson.data.tool) : undefined;
const puzzles = await lessonPuzzles(lesson.id);
const first = puzzles[0];
const practice = PRACTICE[lesson.id];
---

<Base title={lesson.data.title} description={lesson.data.summary}>
  <article class="lesson page">
    <header>
      <p class="meta"><a href="/#tracks">Track {track.number}: {track.title}</a></p>
      <h1>{lesson.data.title}</h1>
      <p class="summary">{lesson.data.summary}</p>
      <p class="meta">About {lesson.data.minutes} minutes{tool && `. Finishing it adds the ${tool.name} to your toolkit.`}</p>
    </header>

    <Content />

    <div class="end">
      <LessonComplete
        client:load
        lessonId={lesson.id}
        toolName={tool?.name}
        firstPuzzle={first && { href: `/puzzles/${first.id}`, title: first.data.title }}
      />
    </div>

    {
      puzzles.length > 0 && (
        <section class="puzzles" aria-labelledby="puzzles-title">
          <h2 id="puzzles-title">Puzzles</h2>
          <p class="meta">You can try them at any time, but they're easier once the lesson is done.</p>
          <PuzzleList puzzles={puzzles} />
          {practice && (
            <p class="more">
              Want more? <a href={practice.href}>{practice.title}</a> gives you a new message every time.
            </p>
          )}
        </section>
      )
    }
  </article>
</Base>

<style>
  .lesson header {
    display: grid;
    gap: 0.75rem;
    padding-block: 2rem 0.5rem;
    max-width: var(--measure);
  }
  .lesson h1 {
    font-size: var(--step-4);
  }
  .summary {
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .end {
    margin-top: 3.5rem;
    max-width: var(--measure);
  }
  .more {
    margin-top: 0.5rem;
  }
  .puzzles {
    display: grid;
    gap: 0.75rem;
    margin-top: 3.5rem;
    max-width: var(--measure);
  }
</style>
