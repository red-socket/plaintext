---
import Base from '../layouts/Base.astro';
import DecodeLine from '../components/DecodeLine.astro';
import { TRACKS } from '../lib/catalog';
import { sortedCases, sortedLessons } from '../lib/content';

const lessons = await sortedLessons();
const cases = await sortedCases();
const first = lessons[0];
---

<Base>
  <section class="hero page">
    <DecodeLine text="Every secret message was written to be read." />
    <div class="intro prose">
      <p>
        Plaintext teaches the ciphers, encodings and hidden-data tricks behind puzzle hunts, ARGs and escape rooms. Each lesson takes about ten
        minutes, ends with puzzles to solve, and gives you a tool to keep.
      </p>
      {first && <p><a class="btn" href={`/learn/${first.id}`}>Start the first lesson</a> <span class="meta first">{first.data.title}, {first.data.minutes} minutes</span></p>}
    </div>
  </section>

  <section id="tracks" class="tracks page" aria-labelledby="tracks-title">
    <h2 id="tracks-title">Tracks</h2>
    <ol>
      {
        TRACKS.map((t) => {
          const trackLessons = lessons.filter((l) => l.data.track === t.id);
          return (
            <li class:list={['track', { empty: trackLessons.length === 0 }]}>
              <span class="n">{t.number}</span>
              <div>
                <h3>{t.title}</h3>
                <p class="blurb">{t.blurb}</p>
                {trackLessons.length > 0 ? (
                  <ul class="lessons">
                    {trackLessons.map((l) => (
                      <li>
                        <a href={`/learn/${l.id}`}>{l.data.title}</a> <span class="meta">{l.data.minutes} min</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="meta">Not written yet.</p>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  {
    cases.length > 0 && (
      <section class="cases page" aria-labelledby="cases-title">
        <h2 id="cases-title">Cases</h2>
        <p class="lead">Story puzzles that mix everything, with nothing to say which technique comes next.</p>
        <ul>
          {cases.map((c) => (
            <li>
              <span class="n">{c.data.number}</span>
              <div>
                <h3><a href={`/cases/${c.id}`}>{c.data.title}</a></h3>
                <p>{c.data.summary}</p>
                <p class="meta">{c.data.after}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="drill-cta page" aria-labelledby="drill-title">
    <h2 id="drill-title">What is it?</h2>
    <p>The skill under every puzzle: look at a sample and say what it is. <a href="/drill">Practise spotting ciphers and encodings</a>.</p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem 4rem;
  }
  @media (min-width: 48rem) {
    .hero {
      padding-block: 6rem 5rem;
    }
  }
  .intro {
    font-size: var(--step-1);
    line-height: 1.5;
  }
  .intro .btn {
    font-size: var(--step-0);
  }
  .first {
    margin-left: 0.75rem;
  }

  .tracks h2 {
    margin-bottom: 1.5rem;
  }
  .tracks > ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .track {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .track .n {
    font-family: var(--mono);
    font-size: var(--step-1);
    color: var(--violet);
    line-height: 1.2;
  }
  .track h3 {
    font-size: var(--step-1);
  }
  .blurb {
    margin-top: 0.25rem;
    max-width: var(--measure);
  }
  .track.empty h3,
  .track.empty .n {
    color: var(--ink-soft);
  }
  .lessons {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    font-weight: 600;
  }
  .lessons .meta {
    font-weight: 400;
    margin-left: 0.4rem;
  }
  .cases,
  .drill-cta {
    margin-top: 4rem;
  }
  .cases h2,
  .drill-cta h2 {
    margin-bottom: 0.75rem;
  }
  .lead {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }
  .cases ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .cases li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .cases li p {
    max-width: var(--measure);
    margin-top: 0.25rem;
  }
  .cases .n {
    font-family: var(--mono);
    font-size: var(--step-1);
    color: var(--violet);
    line-height: 1.2;
  }
  .cases h3 {
    font-size: var(--step-1);
  }
  .drill-cta p {
    max-width: var(--measure);
  }
  .track > div > .meta {
    margin-top: 0.5rem;
  }
</style>
