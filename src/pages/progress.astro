---
import Base from '../layouts/Base.astro';
import ProgressPanel from '../components/ProgressPanel.svelte';
import { casePuzzles, lessonPuzzles, sortedCases, sortedLessons } from '../lib/content';

const lessons = await Promise.all(
  (await sortedLessons()).map(async (l) => ({
    kind: 'lesson' as const,
    id: l.id,
    title: l.data.title,
    href: `/learn/${l.id}`,
    puzzles: (await lessonPuzzles(l.id)).map((p) => ({ id: p.id, title: p.data.title })),
  })),
);
const cases = await Promise.all(
  (await sortedCases()).map(async (c) => ({
    kind: 'case' as const,
    id: c.id,
    title: `Case ${c.data.number}: ${c.data.title}`,
    href: `/cases/${c.id}`,
    puzzles: (await casePuzzles(c.id)).map((p) => ({ id: p.id, title: p.data.title })),
  })),
);
---

<Base title="Your progress" description="What you've solved, and how to move your progress to another device.">
  <div class="progress page">
    <header class="prose">
      <h1>Your progress</h1>
      <p>There are no accounts. Everything you've done is saved in this browser.</p>
    </header>
    <ProgressPanel client:load groups={[...lessons, ...cases]} />
  </div>
</Base>

<style>
  .progress {
    display: grid;
    gap: 2rem;
  }
  header {
    display: grid;
    gap: 0.75rem;
    padding-top: 2.5rem;
  }
</style>
