---
import Base from '../../layouts/Base.astro';
import Practice from '../../components/Practice.svelte';
import Toolkit from '../../components/Toolkit.astro';
import { getEntry } from 'astro:content';

const lesson = (await getEntry('lessons', 'caesar'))!;
---

<Base title="Caesar practice" description="Endless Caesar cipher messages to decode, with or without the key.">
  <div class="practice-page page">
    <header class="prose">
      <p class="meta"><a href={`/learn/${lesson.id}`}>{lesson.data.title}</a></p>
      <h1>Caesar practice</h1>
      <p>A new message every time. Nothing here is saved or scored; it's just practice.</p>
    </header>

    <Practice client:load />

    <Toolkit open="caesar-wheel" />
  </div>
</Base>

<style>
  .practice-page {
    display: grid;
    gap: 2rem;
  }
  header {
    display: grid;
    gap: 0.6rem;
    padding-top: 2rem;
  }
  h1 {
    font-size: var(--step-4);
  }
</style>
