---
import { url } from '../../lib/url';
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Practice from '../../components/Practice.svelte';
import Toolkit from '../../components/Toolkit.astro';
import { PRACTICE } from '../../lib/catalog';

export function getStaticPaths() {
  return Object.entries(PRACTICE).map(([lessonId, p]) => ({ params: { id: p.cipher }, props: { lessonId, ...p } }));
}

const { lessonId, title, cipher, tool, description } = Astro.props;
const lesson = (await getEntry('lessons', lessonId))!;
---

<Base title={title} description={description}>
  <div class="practice-page page">
    <header class="prose">
      <p class="meta"><a href={url(`/learn/${lesson.id}`)}>{lesson.data.title}</a></p>
      <h1>{title}</h1>
      <p>A new message every time. Nothing here is saved or scored; it's just practice.</p>
    </header>

    <Practice client:load cipher={cipher} />

    <Toolkit open={tool} />
  </div>
</Base>

<style>
  .practice-page {
    display: grid;
    gap: 2rem;
  }
  header {
    display: grid;
    gap: 0.6rem;
    padding-top: 2.5rem;
  }
</style>
