---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ToolGate from '../components/ToolGate.astro';
import ToolView from '../components/tools/ToolView.astro';
import { TOOLS, TRACKS } from '../lib/catalog';

const lessons = await getCollection('lessons');
const lessonOf = (id: string) => lessons.find((l) => l.id === id);
const groups = TRACKS.map((t) => ({ track: t, tools: TOOLS.filter((tool) => lessonOf(tool.lesson)?.data.track === t.id) })).filter((g) => g.tools.length);
---

<Base title="Toolkit" description="The tools you've earned by finishing lessons.">
  <div class="toolkit page">
    <header class="prose">
      <h1>Toolkit</h1>
      <p>Every lesson you finish adds a tool here. You'll also find your tools under every puzzle. Tools you haven't earned yet stay redacted.</p>
    </header>

    {
      groups.map((g) => (
        <section class="group" aria-labelledby={`track-${g.track.id}`}>
          <h2 id={`track-${g.track.id}`}>
            <span>{g.track.title}</span>
            <span class="n">Track {g.track.number}</span>
          </h2>
          {g.tools.map((tool) => (
            <details class="tool" data-lesson={tool.lesson} data-unlocked="false">
              <summary>
                <span class="name">{tool.name}</span>
                <span class="lock">Locked</span>
                <span class="desc">
                  <span>{tool.description}</span>
                </span>
              </summary>
              <div class="body">
                <ToolGate tool={tool.id} lessonTitle={lessonOf(tool.lesson)?.data.title ?? tool.lesson}>
                  <ToolView tool={tool.id} />
                </ToolGate>
              </div>
            </details>
          ))}
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { isLessonDone, progress } from '../lib/progress';

  const items = document.querySelectorAll<HTMLElement>('details.tool');
  progress.subscribe((p) => {
    for (const d of items) d.dataset.unlocked = String(isLessonDone(p, d.dataset.lesson!));
  });
</script>

<style>
  .toolkit {
    display: grid;
    gap: 2.25rem;
  }
  header {
    display: grid;
    gap: 0.9rem;
    padding-top: 2.5rem;
  }
  .group {
    max-width: 56rem;
    border: 2px solid var(--ink);
    background: var(--field);
  }
  .group h2 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.8rem 1rem 0.7rem;
    font-size: 1.75rem;
  }
  .n {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
    font-stretch: 100%;
    color: var(--ink-soft);
  }
  .tool {
    border-top: 1px dashed var(--rule);
  }
  .tool:first-of-type {
    border-top: 2px solid var(--ink);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    padding: 0.7rem 1rem 0.8rem;
    cursor: pointer;
    list-style: none;
  }
  summary:hover {
    background: var(--tint);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-left: auto;
    border: 2px solid var(--ink);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
  }
  details[open] > summary::after {
    content: '−';
    background: var(--ink);
    color: var(--field);
  }
  .name {
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .lock {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    border: 1.5px solid var(--ink-soft);
    padding: 0 0.4em;
  }
  .tool[data-unlocked='true'] .lock {
    display: none;
  }
  .desc {
    order: 5;
    flex: 1 1 100%;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  /* Until it's earned, a tool's description is blacked out line by line, like a redacted file. */
  .tool[data-unlocked='false'] .desc span {
    color: transparent;
    background: var(--bar);
    box-shadow: inset 0 0 0 1px var(--bar-edge);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    user-select: none;
  }
  .body {
    padding: 0.25rem 1rem 1.25rem;
  }
</style>
