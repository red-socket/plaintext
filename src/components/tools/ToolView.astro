---
/** Renders a tool by id. `text` pre-fills it (a puzzle's ciphertext, for example). */
import Base64Tool from './Base64Tool.svelte';
import BaseConverter from './BaseConverter.svelte';
import CipherWheel from './CipherWheel.svelte';
import LetterNumbers from './LetterNumbers.svelte';
import MorseTool from './MorseTool.svelte';
import BaconTool from './BaconTool.svelte';
import BookTool from './BookTool.svelte';
import PigpenTool from './PigpenTool.svelte';
import PolybiusTool from './PolybiusTool.svelte';
import SubstitutionTool from './SubstitutionTool.svelte';
import TranspositionTool from './TranspositionTool.svelte';
import VigenereTool from './VigenereTool.svelte';
import ImageInspector from './ImageInspector.svelte';
import InvisibleInkTool from './InvisibleInkTool.svelte';
import MetadataViewer from './MetadataViewer.svelte';
import SpectrogramViewer from './SpectrogramViewer.svelte';
import SstvDecoder from './SstvDecoder.svelte';
import TextReader from './TextReader.svelte';
import CharInspector from './CharInspector.svelte';
import CodeScanner from './CodeScanner.svelte';
import HashCalculator from './HashCalculator.svelte';
import HexViewer from './HexViewer.svelte';
import EnigmaTool from './EnigmaTool.svelte';
import KeyExchangeTool from './KeyExchangeTool.svelte';
import RsaTool from './RsaTool.svelte';
import XorTool from './XorTool.svelte';

interface Props {
  tool: string;
  text?: string;
  /** A source text (for the book cipher helper and text reader). */
  page?: string;
  /** A file URL (for tools that open images or sounds). */
  file?: string;
}

const { tool, text = '', page = '', file } = Astro.props;
---

{tool === 'caesar-wheel' && <CipherWheel client:visible shift={text ? 0 : 3} mode={text ? 'decrypt' : 'encrypt'} text={text} />}
{tool === 'letter-numbers' && <LetterNumbers client:visible text={text} />}
{tool === 'morse-key' && <MorseTool client:visible text={text} />}
{tool === 'base-converter' && <BaseConverter client:visible text={text} />}
{tool === 'base64' && <Base64Tool client:visible text={text} />}
{tool === 'substitution' && <SubstitutionTool client:visible text={text} />}
{tool === 'polybius' && <PolybiusTool client:visible text={text} />}
{tool === 'vigenere' && <VigenereTool client:visible text={text} />}
{tool === 'transposition' && <TranspositionTool client:visible text={text} />}
{tool === 'bacon' && <BaconTool client:visible text={text} />}
{tool === 'pigpen' && <PigpenTool client:visible />}
{tool === 'book' && <BookTool client:visible text={text} source={page} />}
{tool === 'text-reader' && <TextReader client:visible text={page || text} />}
{tool === 'invisible-ink' && <InvisibleInkTool client:visible text={text} />}
{tool === 'metadata' && <MetadataViewer client:visible file={file} />}
{tool === 'image-inspector' && <ImageInspector client:visible file={file} />}
{tool === 'spectrogram' && <SpectrogramViewer client:visible file={file} />}
{tool === 'sstv' && <SstvDecoder client:visible file={file} />}
{tool === 'char-inspector' && <CharInspector client:visible text={text} />}
{tool === 'hex-viewer' && <HexViewer client:visible file={file} />}
{tool === 'hash-calculator' && <HashCalculator client:visible text={text} source={page} />}
{tool === 'code-scanner' && <CodeScanner client:visible file={file} />}
{tool === 'xor' && <XorTool client:visible text={text} />}
{tool === 'enigma' && <EnigmaTool client:visible text={text} />}
{tool === 'key-exchange' && <KeyExchangeTool client:visible />}
{tool === 'rsa' && <RsaTool client:visible />}
