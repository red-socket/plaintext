---
/**
 * The player's unlocked tools under a puzzle or practice page, grouped by track, each in a
 * collapsible panel. Which tools are unlocked lives in the browser, so the script decides what to show.
 */
import { getCollection } from 'astro:content';
import { TOOLS, TRACKS } from '../lib/catalog';
import ToolView from './tools/ToolView.astro';

interface Props {
  /** Pre-fills every tool. */
  text?: string;
  /** This tool starts open. */
  open?: string;
  /** A source text shown with the puzzle, passed to the book cipher helper and text reader. */
  page?: string;
  /** The puzzle's first file, for tools that open files. */
  file?: string;
}

const { text = '', open, page, file } = Astro.props;
const lessons = await getCollection('lessons');
const trackOf = (lessonId: string) => lessons.find((l) => l.id === lessonId)?.data.track;
const groups = TRACKS.map((t) => ({ track: t, tools: TOOLS.filter((tool) => trackOf(tool.lesson) === t.id) })).filter((g) => g.tools.length);
---

<section class="toolkit" aria-labelledby="toolkit-title">
  <div class="kit-head">
    <h2 id="toolkit-title">Your toolkit</h2>
    <p class="filing">Tools you've earned, by track. Each one starts with the text on this page.</p>
  </div>
  {
    groups.map((g) => (
      <div class="kit-group" hidden>
        <h3 class="kit-track">
          <span>{g.track.title}</span>
          <span>Track {g.track.number}</span>
        </h3>
        {g.tools.map((t) => (
          <details class="kit-tool" data-lesson={t.lesson} open={t.id === open} hidden>
            <summary>
              <span class="name">{t.name}</span>
              <span class="desc">{t.description}</span>
            </summary>
            <div class="body">
              <ToolView tool={t.id} text={text} page={page} file={file} />
            </div>
          </details>
        ))}
      </div>
    ))
  }
  <p class="kit-empty filing" hidden>No tools yet. Finishing a lesson earns you its tool, and it appears here on every puzzle.</p>
  <p class="kit-more meta" hidden><span></span> <a href="/toolkit">See your toolkit</a>.</p>
</section>

<script>
  import { TOOLS } from '../lib/catalog';
  import { isLessonDone, progress } from '../lib/progress';

  for (const kit of document.querySelectorAll<HTMLElement>('.toolkit')) {
    const empty = kit.querySelector<HTMLElement>('.kit-empty')!;
    const more = kit.querySelector<HTMLElement>('.kit-more')!;
    progress.subscribe((p) => {
      let shown = 0;
      for (const group of kit.querySelectorAll<HTMLElement>('.kit-group')) {
        let inGroup = 0;
        for (const d of group.querySelectorAll<HTMLDetailsElement>('.kit-tool')) {
          const on = isLessonDone(p, d.dataset.lesson!);
          d.hidden = !on;
          if (on) inGroup++;
        }
        group.hidden = inGroup === 0;
        shown += inGroup;
      }
      const locked = TOOLS.length - shown;
      empty.hidden = shown > 0;
      more.hidden = shown === 0 || locked === 0;
      more.querySelector('span')!.textContent = `${locked} more tool${locked === 1 ? '' : 's'} to earn.`;
    });
  }
</script>

<style>
  .toolkit {
    margin-top: 2rem;
    max-width: 56rem;
    border: 2px solid var(--ink);
    background: var(--field);
  }
  .kit-head {
    padding: 0.9rem 1rem 0.75rem;
  }
  h2 {
    font-size: 1.875rem;
    margin-bottom: 0.2rem;
  }
  .kit-group {
    display: grid;
    border-top: 2px solid var(--ink);
  }
  /* An explicit display beats the browser's own [hidden] rule, so restate it. */
  .kit-group[hidden],
  .kit-tool[hidden] {
    display: none;
  }
  .kit-track {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.4rem;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.8125rem;
    line-height: 1.3;
    font-stretch: 100%;
    color: var(--ink-soft);
  }
  .kit-tool {
    border-top: 1px dashed var(--rule);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 0.65rem 1rem 0.75rem;
    cursor: pointer;
    list-style: none;
  }
  summary:hover {
    background: var(--tint);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '+';
    order: 3;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-left: auto;
    border: 2px solid var(--ink);
    font-family: var(--mono);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
  }
  details[open] > summary::before {
    content: '−';
    background: var(--ink);
    color: var(--field);
  }
  .name {
    font-weight: 700;
    font-size: 1.0625rem;
  }
  .desc {
    color: var(--ink-soft);
    font-size: 0.9375rem;
    flex: 1 1 18rem;
    order: 2;
  }
  .body {
    padding: 0 1rem 1.25rem;
  }
  .kit-empty,
  .kit-more {
    padding: 0.75rem 1rem 1rem;
    border-top: 2px solid var(--ink);
  }
</style>
