---
/**
 * The home page's opening line, set as an interlinear: each word's ciphertext sits above it, and the
 * redaction bars over the plain words pull away one by one on load. Screen readers get the plain line only.
 */
import { caesarEncrypt } from '../lib/caesar';

interface Props {
  text: string;
  shift?: number;
}

const { text, shift = 3 } = Astro.props;
const words = text.split(' ').map((plain) => ({ plain, cipher: caesarEncrypt(plain, shift).toUpperCase() }));
---

<h1 class="ilin">
  {
    words.map((w, i) => (
      <span class="w">
        <span class="c" aria-hidden="true">
          {w.cipher}
        </span>
        <span class="p" style={`--i:${i}`}>
          {w.plain}
        </span>
      </span>
    ))
  }
</h1>

<style>
  .ilin {
    display: flex;
    flex-wrap: wrap;
    gap: 0.18em 0.3em;
    font-weight: 800;
    font-size: clamp(3rem, 1rem + 7vw, 6.4rem);
    line-height: 0.92;
    font-stretch: 68%;
    letter-spacing: -0.005em;
  }
  .w {
    display: inline-flex;
    flex-direction: column;
  }
  .c {
    font-family: var(--mono);
    font-weight: 500;
    font-size: clamp(0.8rem, 0.6rem + 0.6vw, 1rem);
    line-height: 1;
    letter-spacing: 0.22em;
    color: var(--ink-soft);
    padding-bottom: 0.55rem;
    margin-bottom: 0.45rem;
    border-bottom: 1px dashed var(--rule);
  }
  .p {
    position: relative;
    align-self: flex-start;
  }
  .p::after {
    content: '';
    position: absolute;
    inset: 0.1em -0.05em 0.02em;
    background: var(--bar);
    box-shadow: inset 0 0 0 1px var(--bar-edge);
    transform-origin: 100% 50%;
    animation: declassify 0.55s cubic-bezier(0.7, 0, 0.25, 1) forwards;
    animation-delay: calc(var(--i) * 140ms + 500ms);
  }
  @keyframes declassify {
    to {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .p::after {
      display: none;
    }
  }
</style>
