---
interface Props {
  n: number;
  title: string;
}
const { n, title } = Astro.props;
const id = `step-${n}`;
---

<section class="step" aria-labelledby={id}>
  <h2 id={id}><span class="n">Step {n}</span>{title}</h2>
  <div class="body prose"><slot /></div>
</section>

<style>
  .step {
    display: grid;
    gap: 1rem;
    padding-top: 3rem;
  }
  h2 {
    font-size: clamp(1.875rem, 1.5rem + 1.2vw, 2.25rem);
    max-width: 44rem;
  }
  .n {
    display: block;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1;
    font-stretch: 100%;
    color: var(--ink-soft);
    margin-bottom: 0.6rem;
  }
  .body {
    max-width: 44rem;
  }
  .body :global(> p),
  .body :global(> ul),
  .body :global(> ol) {
    max-width: var(--measure);
  }
</style>
