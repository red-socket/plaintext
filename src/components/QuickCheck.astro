---
/**
 * A small question inside a lesson. The answer is sealed at build time and never reaches the page.
 * Usage in MDX: <QuickCheck id="caesar-cat" answer="FDW" note="C→F, A→D, T→W.">Encode CAT with shift 3.</QuickCheck>
 */
import { sealAll } from '../lib/seal';
import QuickCheckForm from './QuickCheckForm.svelte';

interface Props {
  id: string;
  answer: string | string[];
  note?: string;
}

const { id, answer, note } = Astro.props;
const answers = Array.isArray(answer) ? answer : [answer];
const entries = await sealAll(
  `check/${id}`,
  answers.map((a) => ({ answer: a, payload: { type: 'solve' as const, note, display: a.toUpperCase() } })),
);
---

<div class="quick-check squared" data-check-id={id}>
  <p class="head"><span class="ex" aria-hidden="true"></span><span>Quick check</span></p>
  <div class="inner">
    <p class="q"><slot /></p>
    <QuickCheckForm client:idle id={id} entries={entries} />
  </div>
</div>

<style>
  /* Numbered as exercises through the lesson: the counter is reset on the lesson article. */
  .quick-check {
    counter-increment: exercise;
    border: 2px solid var(--ink);
    background-color: var(--field);
  }
  .head {
    display: flex;
    align-items: stretch;
    background: var(--ink);
    color: var(--paper);
  }
  .head > span {
    padding: 0.45rem 0.8rem;
  }
  .ex {
    display: flex;
    align-items: center;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.8125rem;
    border-right: 2px solid var(--paper);
  }
  .ex::before {
    content: 'Ex. ' counter(exercise);
  }
  .head > span:last-child {
    font-weight: 700;
    font-size: 1.0625rem;
    font-stretch: 90%;
  }
  .inner {
    padding: 1.1rem 1.1rem 0.75rem;
  }
  .q {
    font-size: 1.1875rem;
    margin-bottom: 0.9rem;
  }
</style>
